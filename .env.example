# Copy this file to .env and fill in real values. .env is git-ignored.

# Deployment mode: "family" for your private instance, "demo" for the public sandbox.
APP_MODE=family

# Demo mode disables destructive actions and enables periodic data reset.
DEMO_MODE=false

# PostgreSQL
POSTGRES_USER=dailybread
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dailybread
# Hostname "db" is the database service name in docker-compose.
DATABASE_URL=postgresql+psycopg://dailybread:change-me@db:5432/dailybread

# Backend
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Strava (optional; leave blank to disable)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# USDA FoodData Central API key (optional; leave blank to use a local import only)
USDA_API_KEY=

# Web Push reminders (optional; leave blank to disable notifications).
# Generate a key pair once:
#   python -c "import base64; from cryptography.hazmat.primitives import serialization; from cryptography.hazmat.primitives.asymmetric import ec; k=ec.generate_private_key(ec.SECP256R1()); e=lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode(); print('VAPID_PUBLIC_KEY='+e(k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint))); print('VAPID_PRIVATE_KEY='+e(k.private_numbers().private_value.to_bytes(32,'big')))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI the push services may use to reach the server operator.
VAPID_SUBJECT=mailto:admin@example.com
# Minutes before a timed card that its reminder is sent.
REMINDER_LEAD_MINUTES=15
# Local hour (0-23, before noon) for the morning digest push - a personal
# "Good morning" summary of each adult's day. Needs push configured above.
DIGEST_HOUR=7
# The reminder clock follows the server's local time; in Docker set the
# household timezone here (e.g. America/New_York).
TZ=UTC
